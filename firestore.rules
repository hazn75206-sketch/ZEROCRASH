rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (request.auth.token.role == 'owner' || request.auth.uid == userId);
    }
    match /tq/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /bugs/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /news/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
